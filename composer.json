{
    "name": "teamnovu/laravel-notification-log",
    "description": "Logs every sent Notification and Mail of your entire Project.",
    "keywords": [
        "teamnovu",
        "laravel",
        "laravel-notification-log"
    ],
    "homepage": "https://github.com/teamnovu/laravel-notification-log",
    "license": "MIT",
    "authors": [
        {
            "name": "Oliver Kaufmann",
            "email": "oliver.kaufmann@novu.ch",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-zlib": "*",
        "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.64|^3.0",
        "spatie/laravel-package-tools": "^1.13.0"
    },
    "require-dev": {
        "laravel-notification-channels/telegram": "^3.0|^4.0|^5.0|^6.0|^7.0|^8.0",
        "laravel-notification-channels/webpush": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "laravel/pint": "^1.0",
        "laravel/vonage-notification-channel": "^3.0",
        "nunomaduro/collision": "^6.0|^7.0|^8.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^1.21|^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^1.1|^2.0|^3.0|^4.0",
        "phpunit/phpunit": "^9.5|^10.5|^11.5|^12.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Teamnovu\\LaravelNotificationLog\\": "src",
            "Teamnovu\\LaravelNotificationLog\\Database\\Factories\\": "database/factories"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Teamnovu\\LaravelNotificationLog\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --coverage-filter=src --coverage-html=build/coverage --coverage-text=build/coverage.txt --coverage-clover=build/logs/clover.xml",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teamnovu\\LaravelNotificationLog\\LaravelNotificationLogServiceProvider"
            ],
            "aliases": {
                "LaravelNotificationLog": "Teamnovu\\LaravelNotificationLog\\Facades\\LaravelNotificationLog"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
